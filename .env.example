# Required by SEC fair-access guidance. Use a real application/team name and
# monitored email address when downloading filings.
SEC_USER_AGENT=financial-research-agent/0.1 contact@example.com

# Runtime locations.
FINAGENT_DB_PATH=data/finagent.db
FINAGENT_MCP_URL=http://127.0.0.1:8001/mcp
FINAGENT_API_URL=http://127.0.0.1:8000

# LLM provider. The agent is provider-neutral: pick one adapter and a model.
#   fake               offline deterministic provider (no key, no network; plumbing only)
#   gemini             Google Gemini via the google-genai SDK
#   openai_compatible  OpenAI, or any OpenAI-format server via LLM_BASE_URL
#                      (Groq, Mistral, Together, OpenRouter, DeepSeek, local Ollama /
#                      LM Studio / vLLM). Install with: uv sync --extra openai
#   anthropic          Anthropic Claude. Install with: uv sync --extra anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
# One key variable for every provider. Keep this file keyless; put the real value
# only in the gitignored .env file. GEMINI_API_KEY / OPENAI_API_KEY /
# ANTHROPIC_API_KEY are still accepted as fallbacks.
LLM_API_KEY=
# Only for openai_compatible, e.g. https://api.groq.com/openai/v1 or
# http://localhost:11434/v1 for Ollama (no key needed for local servers).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=2
# Thinking budget for the synthesis call on providers that support one (Gemini).
LLM_SYNTHESIS_THINKING_BUDGET=1024
# Global deadline for one analysis: plan + synthesis + one repair + resolver.
FINAGENT_ANALYSIS_TIMEOUT_SECONDS=75

# Example swaps:
#   LLM_PROVIDER=openai_compatible LLM_MODEL=gpt-4o-mini LLM_API_KEY=sk-...
#   LLM_PROVIDER=openai_compatible LLM_MODEL=llama-3.3-70b-versatile LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_PROVIDER=openai_compatible LLM_MODEL=llama3.1 LLM_BASE_URL=http://localhost:11434/v1
#   LLM_PROVIDER=anthropic LLM_MODEL=claude-opus-5 LLM_API_KEY=sk-ant-...
