# Required by SEC fair-access guidance. Use a real application/team name and
# monitored email address when downloading filings.
SEC_USER_AGENT=financial-research-agent/0.1 contact@example.com

# Runtime locations.
FINAGENT_DB_PATH=data/finagent.db
FINAGENT_MCP_URL=http://127.0.0.1:8001/mcp
FINAGENT_API_URL=http://127.0.0.1:8000

# Live model configuration. Gemini 2.5 Flash-Lite has a limited free tier.
# Keep this file keyless; put the real value only in the gitignored .env file.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=2
